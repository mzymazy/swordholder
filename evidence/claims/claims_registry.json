      "recomputability": "recomputable=yes 且判定为 V/VR 的声明数 / recomputable=yes 的声明数",
      "disclosure": "已披露负结果数 / 已知负结果总数",
      "penalty": "min(20, 5*未修 F + 3*未修 B + 2*未修 U)",
      "composite": "100*(0.20*trace + 0.35*acc + 0.20*recomp + 0.25*disc) - penalty"
